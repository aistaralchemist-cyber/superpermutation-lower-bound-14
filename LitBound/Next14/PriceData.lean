def label (s : State) := labels[s.val/32]![s.val%32]!
def pot (s : State) := potentials[s.val/32]![s.val%32]!
def col : Tile → Nat
  | .efficient => 0 | .shortFirst => 1 | .shortSecond => 2 | .other => 3
def next (s : State) (z : Tile) := table[s.val/32]![s.val%32]![col z]!

def ok (s : State) (z : Tile) : Bool :=
  if h : next s z < 1596 then
    let t : State := ⟨next s z,h⟩
    (label t).isSuffixOf (label s ++ [z]) && decide (8 + pot s ≤ 107 * loss z + pot t)
  else forbidden.any (fun w => w.isSuffixOf (label s ++ [z]))


def rowAt (i : Nat) : Bool :=
  if h : i < 1596 then
    let s : State := ⟨i,h⟩
    ok s A && ok s X && ok s Y && ok s .other
  else true
end HaruhiNextPrice
